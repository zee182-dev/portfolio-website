---
import { site } from '../data/site';
---
<section id="contact">
  <div class="wrap">
    <span class="eyebrow">Contact</span>
    <h2 class="h-sec">Let's work together</h2>
    <p class="lead">Need a site that ranks in Google and gets picked up by AI search — or a WordPress/automation build to back it? I'm available for freelance and full-time roles.</p>
    <div class="contact-grid">
      <a class="cbtn" href={site.whatsapp} target="_blank" rel="noopener"><div><div class="k">WhatsApp</div><div class="v">{site.phone}</div></div></a>
            <a class="cbtn" id="email-link" data-email={site.email} href={`mailto:${site.email}`}><div><div class="k">Email</div><div class="v">{site.email}</div></div></a>
      <a class="cbtn" href={site.linkedin} target="_blank" rel="noopener"><div><div class="k">LinkedIn</div><div class="v">linkedin.com/in/zeeshan-seo</div></div></a>
      <a class="cbtn" href={site.github} target="_blank" rel="noopener"><div><div class="k">GitHub</div><div class="v">github.com/zee182-dev</div></div></a>
    </div>
  </div>
</section>
<footer>
  <div class="wrap">
    <span>© 2026 Zeeshan Arshad</span>
    <span>SEO Specialist · CMS & AI Developer</span>
  </div>
</footer>
<script>
  const link = document.getElementById('email-link');
  if (link) {
    const email = link.getAttribute('data-email');
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (!isMobile) {
      link.setAttribute('href', 'https://mail.google.com/mail/?view=cm&fs=1&to=' + email);
      link.setAttribute('target', '_blank');
      link.setAttribute('rel', 'noopener');
    }
  }
</script>
<a href={site.whatsapp} target="_blank" rel="noopener" class="wa-float" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true">
    <path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.1 1.6 5.9L4 29l8.3-1.6c1.7.9 3.7 1.4 5.7 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-4.9 1 1-4.8-.3-.4A9.7 9.7 0 016.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1c-.2.3-.8 1-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.2-.2.2-.3.3-.5.1-.2.1-.4 0-.5l-.9-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.3 5.1 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3z"/>
  </svg>
</a>

<style>
  .wa-float{position:fixed;right:20px;bottom:20px;z-index:300;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#25D366;color:#fff;box-shadow:0 8px 24px rgba(37,211,102,.4);transition:transform .18s,box-shadow .18s}
  .wa-float:hover{transform:scale(1.08);box-shadow:0 10px 30px rgba(37,211,102,.55)}
  @media (max-width:600px){.wa-float{right:16px;bottom:16px}}
</style>